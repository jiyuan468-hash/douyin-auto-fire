# 本地默认不需要 .env：程序自动读取 config.json 和 storage-state.json。
# GitHub Actions 使用 Cookie-Editor 导出的完整 JSON 数组配置 DOUYIN_COOKIE Secret。

# 抖音登录凭证（二选一）
DOUYIN_STORAGE_STATE=
DOUYIN_COOKIE=

# 通知渠道（可配置多个，逗号分隔：dingtalk,feishu,webhook）
# NOTIFICATION_CHANNELS=dingtalk,feishu,webhook

# 钉钉机器人（DINGTALK_WEBHOOK 和 DINGTALK_SECRET 必须同时配置）
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# 飞书机器人（配置 FEISHU_WEBHOOK 后需在 NOTIFICATION_CHANNELS 中添加 feishu）
FEISHU_WEBHOOK=

# 通用 Webhook（配置 WEBHOOK_URL 后需在 NOTIFICATION_CHANNELS 中添加 webhook）
WEBHOOK_URL=
WEBHOOK_METHOD=POST
# WEBHOOK_HEADERS=X-Custom-Header: value1 Another-Header: value2

# 运行模式
HEADLESS=false

# 追踪调试（运行时保存 Playwright Trace，调试完成后建议关闭）
TRACE=true

# 自定义浏览器路径（可选）
# BROWSER_PATH=

# 任务配置路径（默认读取当前目录的 config.json）
# TASK_CONFIG=config.json

# 产物输出目录（默认 artifacts/）
# ARTIFACTS_DIR=artifacts
